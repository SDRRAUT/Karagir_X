# Kalakar Setu Mobile — Environment Variables Example
# DO NOT COMMIT SENSITIVE SECRETS (e.g. Service Role Keys) HERE

# Supabase Project Configuration (Client-Safe Anon Credentials)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-client-safe-anon-key

# App Environment
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000
